# tmux-agents — optional quality-of-life settings for running agents in tmux.
#
# NOT required by anything in this repo. Installed only with `./install.sh
# --with-extras`, because these are opinions about your tmux, not dependencies.
# Read it, take what you want, or copy the lines into your own config instead.

# ---------------------------------------------------------------------------
# The one that matters most for Claude Code
# ---------------------------------------------------------------------------
# tmux waits 500ms after Esc to see whether it's part of an escape sequence.
# Inside Claude Code that makes Esc (interrupt / clear input) feel broken. Zero is
# safe on a local machine; raise it if you drive tmux over a laggy SSH link.
set -sg escape-time 0

# Let programs know when their pane gains or loses focus. Claude Code and editors
# use this; without it they can't tell they've been backgrounded.
set -g focus-events on

# Let programs pass escape sequences straight through tmux. Needed for OSC 52
# clipboard, terminal notifications, and inline image protocols.
#
# "all", not "on", and agents.conf sets the same: desktop notifications are
# written into the pane of an agent you are NOT looking at, and "on" forwards
# only from the visible pane. Leaving this at "on" here would quietly undo it.
set -g allow-passthrough all

# Copy to the system clipboard through the terminal via OSC 52. This is also what
# makes the file browser's "copy path" work when pbcopy isn't available.
set -g set-clipboard on

# ---------------------------------------------------------------------------
# Colour
# ---------------------------------------------------------------------------
# tmux-256color is the correct inner TERM (screen-256color is the legacy one and
# loses features). It does NOT advertise truecolor, so add RGB for your outer
# terminal explicitly or Claude Code's diffs render in 256 colours.
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-ghostty:RGB"
set -as terminal-features ",xterm-256color:RGB"

# ---------------------------------------------------------------------------
# Scrollback
# ---------------------------------------------------------------------------
# Agents produce a lot of output. 100k lines/pane is roughly 20-40MB each worst
# case. Lower it if you run many panes on a memory-tight machine.
set -g history-limit 100000

# ---------------------------------------------------------------------------
# Mouse and navigation
# ---------------------------------------------------------------------------
set -g mouse on
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on
setw -g aggressive-resize on

# vi keys in copy mode (prefix + [ to enter, q to leave)
setw -g mode-keys vi
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-pipe-and-cancel "pbcopy"
bind -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel "pbcopy"

# Splits and new windows inherit the current directory — so a shell you split off
# beside an agent starts in that agent's folder.
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# Pane navigation without the prefix
bind -n M-Left  select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up    select-pane -U
bind -n M-Down  select-pane -D

bind r source-file ~/.tmux.conf \; display "reloaded"

# ---------------------------------------------------------------------------
# Status bar styling
# ---------------------------------------------------------------------------
# Pure cosmetics, and separate from the agent counts on purpose: the counts live
# in agents.conf behind --with-status, this is just what the bar looks like.
# The session name sits in a coloured block on the left so that two terminal
# windows on two sessions are told apart without reading anything.
set -g status-position bottom
set -g status-style "bg=colour234,fg=colour250"
set -g status-left-length 30
set -g status-left "#[bg=colour39,fg=colour232,bold] #S #[default] "

# Don't let a dead shell take the pane's output with it before you've read it.
set -g remain-on-exit off
