# tmux-agents — keybindings, and the two settings agent detection depends on.
#
# This is a TEMPLATE. install.sh renders it to ~/.config/tmux-agents/agents.conf
# with @TMUX_AGENTS_HOME@ replaced by wherever you cloned the repo, and adds a
# single `source-file` line to your ~/.tmux.conf. tmux config has no notion of
# "the directory this file is in", which is the whole reason for the render step.
#
# Editing the rendered copy works until the next install; edit this and re-run
# ./install.sh to make it stick.

# ---------------------------------------------------------------------------
# prefix + a — the agent picker
# ---------------------------------------------------------------------------
# Every agent, with live status and a preview of its screen. From there: enter
# jumps, ctrl-n starts a new agent, ctrl-s starts one beside the highlighted
# agent in the same folder, ctrl-x kills one, ctrl-f browses its files.
#
# '#{client_tty}' is not decoration. tmux expands it here against the client that
# pressed the key, and the picker needs it: inside a popup $TMUX_PANE is empty, so
# a bare switch-client picks a client at random and drags the wrong terminal
# window off to the agent you selected.
bind a run-shell "@TMUX_AGENTS_HOME@/bin/tmux-agent-pick.sh '#{client_tty}'"

# ---------------------------------------------------------------------------
# prefix + j — jump to whoever is waiting on you
# ---------------------------------------------------------------------------
# Goes to the agent that has been waiting longest. Press it again for the next
# one; it tells you how many are left. No list, no choosing.
#
# `j` for jump, and deliberately not `w`: that's tmux's choose-tree, which this
# project's own docs point people at as the replacement for the find-window
# binding that prefix + f takes over.
bind j run-shell "@TMUX_AGENTS_HOME@/bin/tmux-agent-next.sh '#{client_tty}'"

# ---------------------------------------------------------------------------
# prefix + f — the file browser
# ---------------------------------------------------------------------------
# Browse, preview and open the files the agent in this pane is working on.
#
# ⚠️  This REPLACES tmux's default prefix + f (find-window). `prefix + w`
# (choose-tree) covers that ground. Comment this line out if you'd rather keep it,
# or change the key — nothing else depends on which key it is.
#
# '#{pane_id}' is what roots the browser in the right folder; a popup has no
# $TMUX_PANE of its own to work it out from.
bind f run-shell "@TMUX_AGENTS_HOME@/bin/tmux-file-pick.sh '#{pane_id}' '#{client_tty}'"

# ---------------------------------------------------------------------------
# prefix + F — favorites
# ---------------------------------------------------------------------------
# The short list kept by `tf`. Enter starts one, or switches to it if it is
# already running. Same client rule as the picker.
bind F run-shell "@TMUX_AGENTS_HOME@/bin/tmux-favorites-pick.sh '#{client_tty}'"

# ---------------------------------------------------------------------------
# prefix + A — a second agent beside this one
# ---------------------------------------------------------------------------
# Split this window and start an agent in the new pane, on the same folder.
# Press it repeatedly to watch three or four work at once; the window re-tiles
# each time, and each pane's border carries that agent's own status and task.
#
# Capital A because prefix + a is the picker and these belong together: `a`
# finds an agent that exists, `A` makes one here.
#
# Claude Code wants ~80 columns, so this stops being readable past
# window_width/80 panes — it warns rather than refusing, and prefix + z zooms
# one pane full-screen when you want to actually read it.
bind A run-shell "@TMUX_AGENTS_HOME@/bin/tmux-agent-do.sh split '#{pane_id}'"

# ---------------------------------------------------------------------------
# prefix + R — restart the agent in this pane, in place
# ---------------------------------------------------------------------------
# Exit the process and relaunch it on its own exact conversation
# (`claude -r <session-id>`, never --continue, which would resume whichever
# conversation in that DIRECTORY spoke last). This is the one-keystroke fix for
# stale macOS permissions and for picking up MCP/config changes. Works on a dead
# agent too — a pane sitting at its shell prompt just gets the resume command.
#
# Capital R because lowercase r is the config reload. -b is load-bearing: the
# restart waits up to 8s for the process to exit, and a foreground run-shell
# blocks the entire tmux server for that long.
bind R run-shell -b "@TMUX_AGENTS_HOME@/bin/tmux-agent-do.sh restart '#{pane_id}'"

# ---------------------------------------------------------------------------
# prefix + S — put this pane's agent to sleep
# ---------------------------------------------------------------------------
# Exit the process, keep the conversation. The pair to prefix + R, which wakes
# it again.
#
# Worth a key because the cost is real and invisible: a few dozen idle agents
# hold gigabytes of RSS between them, and most are waiting on an answer that is
# not coming today. Sleeping is only safe because the session id is recorded
# first — waking with `claude --continue` would resume the most recent
# conversation in the DIRECTORY, so agents that share a folder would quietly
# come back as each other.
bind S run-shell -b "@TMUX_AGENTS_HOME@/bin/tmux-agent-do.sh sleep '#{pane_id}'"

# ---------------------------------------------------------------------------
# prefix + B — send this pane's agent back home
# ---------------------------------------------------------------------------
# The undo for pulling an agent in (prefix + a, then ctrl-g). Breaks this pane
# back out into the session it came from, or into its own window here if that
# session has since died. `B` beside `A` because they are a pair.
bind B run-shell "@TMUX_AGENTS_HOME@/bin/tmux-agent-do.sh home '#{pane_id}'"

# ---------------------------------------------------------------------------
# prefix + Q — a quick job
# ---------------------------------------------------------------------------
# Type a task, press enter, and the popup closes: `claude -p` runs it detached in
# this pane's folder, and you are told when it is done. prefix + Q again lists
# recent jobs — enter on an empty prompt reads the highlighted one. Capital Q
# because lowercase q is tmux's display-panes.
bind Q run-shell "@TMUX_AGENTS_HOME@/bin/tmux-quick-job.sh --popup '#{client_tty}' '#{pane_id}'"

# ---------------------------------------------------------------------------
# Load-bearing settings
# ---------------------------------------------------------------------------
# Claude Code renames its window to its own version string ("2.1.220"), which
# makes every agent window look identical — and window names are how two agents
# in the same session are told apart in the picker ("api:claude", "api:claude2").
# So renaming is off and windows are named explicitly when they're created.
#
# Verified safe for status detection: with allow-rename off, pane_title still
# tracks Claude Code's "<glyph> <task>" live. Only window_name is frozen.
set -g allow-rename off
setw -g automatic-rename off

# ---------------------------------------------------------------------------
# If your agent lives in a shell alias
# ---------------------------------------------------------------------------
# `t NAME` starts the agent by send-keys into the pane's interactive shell, so
# your aliases apply and you land on a live shell when the agent exits rather
# than the pane dying. But tmux starts a LOGIN shell, which reads ~/.bash_profile
# or ~/.zprofile and never ~/.bashrc. If `claude` is an alias in ~/.bashrc, a
# login shell silently gets the bare binary instead — same command, different
# flags, and nothing anywhere says so.
#
# install.sh renders this line in only when it can see that your interactive
# config is unreachable from a login shell. Force it either way with
# --login-shell / --no-login-shell.
@DEFAULT_COMMAND@set -g default-command "${SHELL}"

# "all", not "on". Desktop notifications ride this: tmux-agent-notify.sh writes
# OSC 777 into the waiting agent's pane for the terminal to show, and the agent
# that needs you is by definition in a window you are NOT looking at. "on"
# forwards only from the visible pane, which silently drops exactly those.
set -g allow-passthrough all

# ---------------------------------------------------------------------------
# Snapshot the server's shape whenever it changes
# ---------------------------------------------------------------------------
# Not just on the 5-minute clock, so a power cut loses seconds of arrangement
# rather than minutes. Each hook fires tmux-agent-autosave.sh, which coalesces
# bursts and refuses to run mid-restore. Index 51 is used throughout to leave
# the lower indexes free for hooks you already have. Always -b: a hook that
# blocks holds the whole server for as long as it runs.
#
# tmux files pane-exited under the window hooks (show-hooks -gw), the other nine
# under -g — so a global count of nine is complete, not one short.
set-hook -g session-created[51] "run-shell -b '@TMUX_AGENTS_HOME@/bin/tmux-agent-autosave.sh'"
set-hook -g session-closed[51] "run-shell -b '@TMUX_AGENTS_HOME@/bin/tmux-agent-autosave.sh'"
set-hook -g session-renamed[51] "run-shell -b '@TMUX_AGENTS_HOME@/bin/tmux-agent-autosave.sh'"
set-hook -g window-linked[51] "run-shell -b '@TMUX_AGENTS_HOME@/bin/tmux-agent-autosave.sh'"
set-hook -g window-unlinked[51] "run-shell -b '@TMUX_AGENTS_HOME@/bin/tmux-agent-autosave.sh'"
set-hook -g after-rename-window[51] "run-shell -b '@TMUX_AGENTS_HOME@/bin/tmux-agent-autosave.sh'"
set-hook -g after-split-window[51] "run-shell -b '@TMUX_AGENTS_HOME@/bin/tmux-agent-autosave.sh'"
set-hook -g after-kill-pane[51] "run-shell -b '@TMUX_AGENTS_HOME@/bin/tmux-agent-autosave.sh'"
set-hook -g pane-exited[51] "run-shell -b '@TMUX_AGENTS_HOME@/bin/tmux-agent-autosave.sh'"
set-hook -g after-select-layout[51] "run-shell -b '@TMUX_AGENTS_HOME@/bin/tmux-agent-autosave.sh'"

# Desktop notification when an agent starts waiting on you. Read at fire time,
# so `tmux set -g @agent-notify 0` silences it immediately, no reload needed.
set -g @agent-notify 1

# ---------------------------------------------------------------------------
# Status line counts — ●working ○idle ◆waiting-on-you
# ---------------------------------------------------------------------------
# Off unless you install with --with-status, because overwriting a status line
# someone has spent time on is rude. To add the counts to your own instead, drop
# this into your existing status-right:
#
#   #(@TMUX_AGENTS_HOME@/bin/tmux-agent-status.sh)
#
@STATUS_COMMENT@set -g status-interval 5
@STATUS_COMMENT@set -g status-right "#(@TMUX_AGENTS_HOME@/bin/tmux-agent-status.sh)  #[fg=colour244]%a %H:%M"
@STATUS_COMMENT@setw -g window-status-format "#[fg=colour244] #I #W#{?window_activity_flag,•,} "
@STATUS_COMMENT@setw -g window-status-current-format "#[bg=colour238,fg=colour255,bold] #I #W "
@STATUS_COMMENT@setw -g monitor-activity on
@STATUS_COMMENT@set -g visual-activity off
